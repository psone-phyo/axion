LANDING_CONTACT_TELEGRAM_URL="#"
LANDING_CONTACT_FACEBOOK_HANDLE="Axion VPN"
LANDING_CONTACT_FACEBOOK_URL="#"
LANDING_CONTACT_MESSENGER_HANDLE="m.me/axionvpn"
LANDING_CONTACT_MESSENGER_URL="#"
